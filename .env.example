# ============================================================================
# Models
# ============================================================================
# No API keys: agents run on the accounts you sign in to on the Connections page
# (Claude via the `claude` CLI, ChatGPT via the `codex` CLI, Gemini via Google sign-in).

# Disabled by default. Enable only for trusted workflows; this is not a sandbox.
# Covers Python nodes, code_save_and_run, execute_code, uv tools, Manim, and local MCP.
# Set in the server environment; workflow vars and tool env overrides cannot enable it.
MAC_ALLOW_UNSAFE_CODE_EXECUTION=0

# ============================================================================
# Optional: Storage location
# ============================================================================
# Where runtime data goes (warehouse/, db/, memory/, logs/, temp/).
# Defaults to <repo>/storage. Relative paths are resolved against the repo root.

# AGENTDEV_STORAGE_DIR=/data/agentdev-storage

# Limits for "Upload folder" (whole project uploads in the web console).
# node_modules, .git, dist, build, .venv... are always skipped.
# MAC_PROJECT_MAX_FILES=5000
# MAC_PROJECT_MAX_MB=300

# ============================================================================
# Optional: Google account sign-in for Gemini (Connections page)
# ============================================================================
# Create an OAuth client in Google Cloud Console; add this redirect URI:
#   ${PUBLIC_BASE_URL}/api/connections/oauth/google/callback

# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# PUBLIC_BASE_URL=http://localhost:8000

# Video rendering (phong_san_xuat_video -> Video Renderer, Google Veo/Imagen). Only used for media generation.
# Needs a Gemini API key from Google AI Studio on a project with Gemini API billing enabled
# (a Google AI Pro subscription opens Veo in the Gemini app/Flow, not in the API). Leave empty to keep script-only.
GEMINI_API_KEY=
